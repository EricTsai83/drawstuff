{
  "name": "@drawstuff/web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "postcss": {
    "plugins": [
      "@tailwindcss/postcss"
    ]
  },
  "scripts": {
    "build": "next build",
    "bundle:guard": "tsx scripts/check-whiteboard-client-bundle.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "migrate:whiteboard-v3": "tsx scripts/migrate-whiteboard-v3.ts",
    "knip": "SKIP_ENV_VALIDATION=1 knip --production --dependencies --files",
    "preview": "next build && next start",
    "start": "next start",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "knip": {
    "entry": [
      "scripts/migrate-whiteboard-v3.ts",
      "scripts/check-whiteboard-client-bundle.ts",
      "playwright.config.ts",
      "src/server/whiteboard/migration-v3.ts",
      "src/test-mode/whiteboard-test-disabled.tsx",
      "tests/e2e/**/*.ts"
    ],
    "ignore": [
      "tests/setup.ts",
      "tests/whiteboard-fixtures.ts"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@drawstuff/whiteboard": "workspace:*",
    "@hookform/resolvers": "^5.5.7",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.27.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.2",
    "pako": "^3.0.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
