# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/apps/web/src/env.ts"
# should be updated accordingly.

UPLOADTHING_TOKEN='something-cool'

POSTGRES_URL="postgres://something-cool"
POSTGRES_URL_NON_POOLING="postgre://something-cool"
POSTGRES_USER="something-cool"
POSTGRES_HOST="something-cool"
POSTGRES_PASSWORD="something-cool"
POSTGRES_DATABASE="something-cool"
POSTGRES_URL_NO_SSL="postgres://something-cool"
POSTGRES_PRISMA_URL="postgres://something-coole"

# Better Auth environment variables
BETTER_AUTH_SECRET="something-cool"
BETTER_AUTH_URL="http://something-cool"


GOOGLE_CLIENT_ID="something-cool"
GOOGLE_CLIENT_SECRET="something-cool"


NEXT_PUBLIC_BASE_URL="http://something-cool"

# 用來作crons job 的 secret token
CRON_SECRET="something-cool"
# 不會被刪除資料的email
CLEANUP_OWNER_EMAIL="something@cool.com"

# 共編 room 授權（Plan 13）。
# 與 @drawstuff/collaboration-relay 共用的 HMAC secret（至少 32 bytes）：
# 簽發 room join token 與 relay control token；relay 端變數名稱相同。
COLLAB_JOIN_TOKEN_SECRET="a-32-byte-or-longer-random-secret-value"
# relay control endpoint 的 origin（server-to-server；不要對外公開）。
COLLAB_RELAY_CONTROL_URL="http://127.0.0.1:3005"
# 瀏覽器連線用的 relay WebSocket endpoint。
NEXT_PUBLIC_COLLAB_RELAY_URL="ws://127.0.0.1:3005"
