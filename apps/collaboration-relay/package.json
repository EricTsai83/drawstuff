{
  "name": "@drawstuff/collaboration-relay",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node --import tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drawstuff/collaboration": "workspace:*",
    "ws": "^8.18.3"
  },
  "knip": {
    "entry": [
      "tests/**/*.test.ts",
      "tests/support/**/*.ts"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "knip": "^6.29.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
