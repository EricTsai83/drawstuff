/**
 * Cloudflare Worker + Durable Object foundation for the collaboration relay
 * migration (Plan 09). The gateway and the `CollaborationRoom` class ship in
 * this one deployment (CLAIM-MIG-3).
 *
 * Single environment by design: this is a solo, self-hosted project, matching
 * how apps/web deploys (main → the one deployment). The Origin allowlist
 * admits the production web app and localhost development; join tokens remain
 * the authorization boundary for every room connection.
 *
 * Lifecycle rules (CLAIM-MIG-4):
 * - `exports` is the declarative Durable Object lifecycle. Any change to it
 *   (create/rename/delete a class) must ship as its own manual deploy, never
 *   mixed with runtime or routing changes, and is never rolled back across.
 *   The config-audit test pins `exports`, so a lifecycle change cannot ride
 *   into an auto-deploy unnoticed.
 * - With `exports` present, `wrangler versions upload` / gradual deployments
 *   are unavailable; code-only changes ship as full `wrangler deploy` (auto
 *   from main via Workers Builds, or `pnpm run deploy` manually).
 *
 * Secrets live in Cloudflare secrets (`pnpm run secret:put`), never in
 * `vars`, git, logs or test fixtures.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drawstuff-collaboration-do",
  "main": "src/index.ts",
  // Pinned to the same date packages/collaboration verified the room-token
  // vectors under (vitest.workerd.config.ts); upgrades are explicit events.
  "compatibility_date": "2026-08-01",
  // `nodejs_compat` lets the Plan-08-verified `room-token` entry run as-is
  // (node:crypto HMAC, CLAIM-DO-6).
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev URL is the pre-cutover smoke/testing surface.
  "workers_dev": true,
  // Minute-level drainer for the collaboration control outbox: the
  // scheduled handler pings the web app's drain endpoint. Lives here instead
  // of Vercel Cron because the Vercel deployment stays on the Hobby plan
  // (daily-only crons); the weekly storage cleanup remains a Vercel cron.
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
  // Declarative SQLite-backed Durable Object lifecycle (mutually exclusive
  // with legacy `migrations` — do not add that key back for gradual rollouts).
  "exports": {
    "CollaborationRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION_ROOM",
        "class_name": "CollaborationRoom",
      },
    ],
  },
  "version_metadata": {
    "binding": "VERSION_METADATA",
  },
  "vars": {
    // Origin is defense-in-depth only (join tokens authorize). Keep entries
    // exact and comma-separated; do not use wildcard origins.
    "COLLAB_ALLOWED_ORIGINS": "https://draw.ericts.com,http://localhost:3000",
  },
  "secrets": {
    // COLLAB_OUTBOX_DRAIN_URL is not sensitive, but it is deployment-specific
    // and `wrangler deploy` replaces dashboard-edited `vars`; a secret is the
    // one binding an operator sets once and deploys never clobber.
    "required": [
      "COLLAB_JOIN_TOKEN_SECRET",
      "COLLAB_CRON_SECRET",
      "COLLAB_OUTBOX_DRAIN_URL",
    ],
  },
}
