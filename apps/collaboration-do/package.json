{
  "name": "@drawstuff/collaboration-do",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:typegen": "wrangler types --strict-vars=false",
    "conformance:remote": "node scripts/conformance-remote.mjs",
    "deploy": "pnpm run verify && pnpm run preflight && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "loadtest": "node scripts/loadtest.mjs",
    "test:p0": "node scripts/p0.mjs",
    "preflight": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "secret:list": "wrangler secret list",
    "secret:put": "wrangler secret put COLLAB_JOIN_TOKEN_SECRET",
    "smoke": "node scripts/smoke.mjs",
    "tail": "wrangler tail --format pretty",
    "test": "vitest run && pnpm run test:maintenance && pnpm run test:harness",
    "test:harness": "node scripts/harness-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm -w knip --workspace apps/collaboration-do",
    "secret:put:identity": "wrangler secret put COLLAB_IDENTITY_SECRET",
    "secret:put:authority": "wrangler secret put COLLAB_AUTHORITY_SECRET",
    "secret:put:adapter": "wrangler secret put COLLAB_ADAPTER_SECRET",
    "secret:put:adapter-url": "wrangler secret put COLLAB_ADAPTER_URL",
    "test:maintenance": "vitest run --config vitest.maintenance.config.ts",
    "preflight:maintenance": "wrangler deploy --config wrangler.maintenance.jsonc --dry-run --outdir .wrangler/maintenance && wrangler deploy --config wrangler.bootstrap.jsonc --dry-run --outdir .wrangler/bootstrap",
    "prepare:rollback": "node scripts/prepare-rollback.mjs",
    "quiesce": "node scripts/quiesce-rooms.mjs"
  },
  "dependencies": {
    "@drawstuff/collaboration": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "eslint": "catalog:",
    "postgres": "^3.4.9",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "ws": "^8.18.3"
  }
}
