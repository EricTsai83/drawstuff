{
  "name": "@drawstuff/collaboration-do",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:typegen": "wrangler types --strict-vars=false",
    "deploy": "pnpm run verify && pnpm run preflight && wrangler deploy",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preflight": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "secret:put": "wrangler secret put COLLAB_JOIN_TOKEN_SECRET",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run knip"
  },
  "dependencies": {
    "@drawstuff/collaboration": "workspace:*",
    "zod": "^4.4.3"
  },
  "knip": {
    "entry": [
      "tests/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "*.ts"
    ],
    "ignoreDependencies": [
      "cloudflare"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "eslint": "^9.39.5",
    "knip": "^6.29.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
