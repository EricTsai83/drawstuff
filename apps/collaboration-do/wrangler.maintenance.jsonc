// P3 manual deployment only. Preserve the existing Worker name and Room namespace.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drawstuff-collaboration-do",
  "main": "src/maintenance.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "exports": {
    "CollaborationRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION_ROOM",
        "class_name": "CollaborationRoom"
      }
    ]
  },
  "secrets": {
    "required": [
      "COLLAB_AUTHORITY_SECRET"
    ]
  }
}
