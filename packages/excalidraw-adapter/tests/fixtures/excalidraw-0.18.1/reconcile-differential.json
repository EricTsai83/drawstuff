        {
          "id": "el-a",
          "index": "a0",
          "version": 2,
          "versionNonce": 500
        }
      ],
      "remote": [
        {
          "id": "el-a",
          "index": "a0",
          "version": 3,
          "versionNonce": 900,
          "backgroundColor": "#ffc9c9"
        }
      ],
      "expected": [
        {
          "backgroundColor": "#ffc9c9",
          "id": "el-a",
          "index": "a0",
          "isDeleted": false,
          "version": 3,
          "versionNonce": 900
        }
      ]
    },
    {
      "name": "local-newer-version-wins",
      "description": "A stale remote update never overwrites a newer local element.",
