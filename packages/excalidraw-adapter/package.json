{
  "name": "@drawstuff/excalidraw-adapter",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./codec": {
      "types": "./src/codec.ts",
      "default": "./src/codec.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "knip": {
    "entry": [
      "tests/**/*.test.{ts,tsx}"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}"
    ],
    "ignoreDependencies": [
      "@excalidraw/excalidraw",
      "@types/react-dom"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "knip": "^6.29.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
