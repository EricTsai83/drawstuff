{
  "name": "@drawstuff/collaboration",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./asset": {
      "types": "./src/asset.ts",
      "default": "./src/asset.ts"
    },
    "./base64": {
      "types": "./src/base64.ts",
      "default": "./src/base64.ts"
    },
    "./client-pacing": {
      "types": "./src/client-pacing.ts",
      "default": "./src/client-pacing.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./keycheck": {
      "types": "./src/keycheck.ts",
      "default": "./src/keycheck.ts"
    },
    "./join-barrier": {
      "types": "./src/join-barrier.ts",
      "default": "./src/join-barrier.ts"
    },
    "./offline-queue": {
      "types": "./src/offline-queue.ts",
      "default": "./src/offline-queue.ts"
    },
    "./recovery": {
      "types": "./src/recovery.ts",
      "default": "./src/recovery.ts"
    },
    "./realtime-crypto": {
      "types": "./src/realtime-crypto.ts",
      "default": "./src/realtime-crypto.ts"
    },
    "./relay-client": {
      "types": "./src/relay-client.ts",
      "default": "./src/relay-client.ts"
    },
    "./relay-control": {
      "types": "./src/relay-control.ts",
      "default": "./src/relay-control.ts"
    },
    "./relay-protocol": {
      "types": "./src/relay-protocol.ts",
      "default": "./src/relay-protocol.ts"
    },
    "./room-auth": {
      "types": "./src/room-auth.ts",
      "default": "./src/room-auth.ts"
    },
    "./room-token": {
      "types": "./src/room-token.ts",
      "default": "./src/room-token.ts"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./src/snapshot.ts"
    },
    "./transport": {
      "types": "./src/transport.ts",
      "default": "./src/transport.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "bench:base64": "vitest run --config vitest.bench-base64.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "knip": {
    "entry": [
      "tests/**/*.test.{ts,tsx}",
      "bench/**/*.test.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}",
      "bench/**/*.ts"
    ],
    "ignoreDependencies": [
      "@vitest/browser"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.5",
    "knip": "^6.29.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
