{
  "name": "drawstuff",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:bootstrap": "pnpm --filter @drawstuff/web admin:bootstrap",
    "audit:ci": "pnpm audit --prod --audit-level=low",
    "baseline:performance": "pnpm --filter @drawstuff/web baseline:performance",
    "baseline:performance:e2e": "pnpm --filter @drawstuff/web baseline:performance:e2e",
    "build": "turbo run build",
    "cf:deploy:production": "pnpm --filter @drawstuff/collaboration-do deploy:production",
    "cf:deploy:staging": "pnpm --filter @drawstuff/collaboration-do deploy:staging",
    "cf:smoke": "pnpm --filter @drawstuff/collaboration-do smoke",
    "db:push": "turbo run db:push --filter=@drawstuff/web",
    "db:studio": "pnpm --filter @drawstuff/web db:studio",
    "dev": "turbo run dev --ui=tui",
    "dev:relay": "pnpm --filter @drawstuff/collaboration-relay dev",
    "dev:web": "pnpm --filter @drawstuff/web dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "knip": "turbo run knip",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "preview": "pnpm build && pnpm start",
    "start": "pnpm --filter @drawstuff/web start",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-drizzle": "^0.2.3",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
