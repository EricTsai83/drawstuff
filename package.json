{
  "name": "drawstuff",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:ci": "node scripts/check-audit-baseline.mjs",
    "build": "next build",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "preview": "next build && next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "knip": "SKIP_ENV_VALIDATION=1 knip --production --dependencies --files",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "knip": {
    "ignore": [
      ".deepsec/deepsec.config.ts",
      "scripts/check-audit-baseline.mjs",
      "packages/whiteboard/tests/fixtures/owned-canvas/performance.ts",
      "packages/whiteboard/tests/setup.ts",
      "tests/setup.ts"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
